  "item": [
    {
      "name": "health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));\r",
              "pm.test(\"reports ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "filter games by min score",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();\r",
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));\r",
              "pm.test(\"responds within 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));\r",
              "pm.test(\"every result meets min_score\", () => {\r",
              "  body.items.forEach(i => pm.expect(i.aggregate_score).to.be.at.least(80));\r",
              "});\r",
              "// Chain: save the first ID for the next request (empty database → nothing saved)\r",
              "if (body.items.length) pm.collectionVariables.set(\"mediaId\", body.items[0].id);\r",
              "else pm.collectionVariables.unset(\"mediaId\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/media?medium=game&min_score=80",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "media"
          ],
          "query": [
            {
              "key": "medium",
              "value": "game"
            },
            {
              "key": "min_score",
              "value": "80"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "media detail",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.collectionVariables.get(\"mediaId\")) pm.execution.skipRequest();"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();\r",
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));\r",
              "pm.test(\"has a scores list\", () => pm.expect(body.scores).to.be.an(\"array\"));\r",
              "pm.test(\"timestamps are UTC (regression)\", () => {\r",
              "  body.scores.forEach(s => pm.expect(s.captured_at).to.match(/(Z|\\+00:00)$/));\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/media/{{mediaId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "media",
            "{{mediaId}}"
          ]
        }
      },
      "response": []
    },
